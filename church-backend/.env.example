# PostgreSQL connection string from Supabase or your hosted database
DATABASE_URL=postgresql://user:password@host:5432/database

# Server settings
PORT=5000
NODE_ENV=production

# Auth secret used to sign login tokens
JWT_SECRET=change_me

# Comma-separated list of allowed CORS origins (defaults include Render and localhost)
# ALLOWED_ORIGINS=https://church-booking-system.onrender.com,http://localhost:3000

# Optional admin seed values
AUTO_SEED_ADMIN=true
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@church.com
ADMIN_PASSWORD=change_this_password

# Email verification (Nodemailer — Gmail SMTP)
# Required for sending verification emails. If not set, users will need admin verification.
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
# Optional: override the "From" address (defaults to SMTP_USER)
# SMTP_FROM=Parish Booking <your-gmail@gmail.com>

# Frontend URL (used for verification links)
FRONTEND_URL=http://localhost:3000
