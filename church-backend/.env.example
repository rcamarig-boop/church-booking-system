# PostgreSQL connection string from Supabase or your hosted database
DATABASE_URL=postgresql://user:password@host:5432/database

# Server settings
PORT=5000
NODE_ENV=production

# Auth secret used to sign login tokens
JWT_SECRET=change_me

# Comma-separated list of allowed CORS origins (defaults include Render and localhost)
# ALLOWED_ORIGINS=https://church-booking-system.onrender.com,http://localhost:3000

# Optional admin seed values
AUTO_SEED_ADMIN=true
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@church.com
ADMIN_PASSWORD=change_this_password

# Email verification (Nodemailer + Gmail)
# Required for sending verification emails. If not set, users will need admin verification.
# Use a Gmail address plus an App Password from your Google account security settings.
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Optional sender override. Defaults to GMAIL_USER.
# EMAIL_FROM=Parish Booking <yourgmail@gmail.com>
# Optional explicit SMTP settings for Gmail/debugging
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_CONNECTION_TIMEOUT=15000
# SMTP_GREETING_TIMEOUT=10000
# SMTP_SOCKET_TIMEOUT=20000

# Frontend URL (used for verification links)
FRONTEND_URL=http://localhost:3000
