# Backend root URL. api.js appends /api automatically if missing.
# For Render single-service deployment (frontend + backend on same URL),
# set to the root URL (without /api):
REACT_APP_API_BASE_URL=https://church-booking-system.onrender.com

# Socket server root URL.
# For Render single-service deployment:
REACT_APP_SOCKET_URL=https://church-booking-system.onrender.com
